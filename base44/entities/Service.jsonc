{
  "name": "Service",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Service Name",
      "description": "The name of the service offered"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "A detailed description of the service"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "description": "The category this service belongs to",
      "enum": [
        "Web Development",
        "Cloud & DevOps",
        "Custom Systems",
        "Mobile Apps",
        "SEO & Marketing",
        "Support"
      ]
    },
    "keyFeatures": {
      "type": "string",
      "title": "Key Features",
      "description": "Comma-separated list of key features or deliverables"
    },
    "icon": {
      "type": "string",
      "title": "Icon",
      "description": "Lucide icon name representing this service"
    },
    "slug": {
      "type": "string",
      "title": "URL Slug",
      "description": "URL-friendly identifier for this service"
    }
  },
  "required": [
    "name",
    "description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}